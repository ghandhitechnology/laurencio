{
  "name": "laurencio",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "build": "bun run --filter '*' build",
    "scan:demo": "bun scripts/scan-demo.ts",
    "e2e:two-home": "bun scripts/two-home-e2e.ts",
    "e2e:server": "bun scripts/e2e-server.ts",
    "merge:demo": "bun scripts/merge-demo.ts",
    "auth:demo": "bun scripts/auth-demo.ts",
    "secret:demo": "bun scripts/secret-scan-demo.ts",
    "cli:test": "bash scripts/cli-tests.sh",
    "e2e:all": "bun run e2e:two-home && bun run e2e:server",
    "verify": "bun run check && bun run lint && bun test && bun run e2e:all && bun run cli:test",
    "smoke:live": "bun scripts/smoke-live.ts",
    "start": "bun packages/server/src/db/migrate.ts && bun packages/server/src/index.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
