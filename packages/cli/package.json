{
  "name": "@laurencio/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "laurencio command line interface",
  "engines": {
    "bun": ">=1.3.0"
  },
  "bin": {
    "laurencio": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build --target=bun --external @napi-rs/keyring --outfile dist/index.js src/index.ts",
    "cli:test": "bash ../../scripts/cli-tests.sh",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.0"
  },
  "devDependencies": {
    "@laurencio/core": "workspace:*",
    "@laurencio/protocol": "workspace:*",
    "@types/picomatch": "^4.0.2",
    "picomatch": "^4.0.4",
    "smol-toml": "^1.8.0"
  }
}
