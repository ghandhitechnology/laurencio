# Laurencio server configuration. Copy to .env for local development.
# Production values come from the Railway service variables.

# --- Basics ---------------------------------------------------------------
# development | test | staging | production. Production refuses the staging
# email sign-in path and the filesystem storage driver.
NODE_ENV=development
PORT=8787
LOG_LEVEL=info

# --- Database -------------------------------------------------------------
# Postgres for anything deployed. Without it the server runs an embedded
# PGlite database at PGLITE_DATA_DIR, which is development only.
DATABASE_URL=postgres://laurencio:laurencio@localhost:5432/laurencio
# PGLITE_DATA_DIR=.data/pglite
# Apply migrations on boot. Defaults to on outside production; production
# relies on the Railway pre-deploy command instead.
# AUTO_MIGRATE=1

# --- Auth -----------------------------------------------------------------
# Session signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-32-bytes-of-randomness
# Public origin for browser sign-in and device approval.
BETTER_AUTH_URL=http://localhost:8787
# Extra origins allowed to post to /api/auth (comma separated).
# TRUSTED_ORIGINS=
# Development/staging email access, without email verification. Never enable in production.
ALLOW_DEV_SIGNIN=1
# Required when NODE_ENV=staging and ALLOW_DEV_SIGNIN=1. Comma-separated emails.
# STAGING_EMAIL_ALLOWLIST=you@example.com
# Device flow: minimum polling interval and the accepted client id.
DEVICE_POLL_INTERVAL=5s
DEVICE_CLIENT_ID=laurencio-cli

# --- Storage --------------------------------------------------------------
# s3 for the Railway bucket, fs for local development. Defaults to s3 when a
# bucket variable is present, fs otherwise.
# STORAGE_DRIVER=s3
# S3_BUCKET / BUCKET, plus S3_REGION/REGION, S3_ENDPOINT/ENDPOINT,
# S3_ACCESS_KEY_ID/ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY/SECRET_ACCESS_KEY.
# FS_STORAGE_DIR=.data/blobs
# FS_STORAGE_SECRET=development-only-signing-key

# --- Limits ---------------------------------------------------------------
QUOTA_MAX_BYTES=536870912
QUOTA_MAX_BLOBS=20000
QUOTA_MAX_BLOB_BYTES=67108864
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PER_SECOND=5

# --- Garbage collection ---------------------------------------------------
# Unreferenced blobs younger than this are kept: a slow upload is not garbage.
GC_GRACE_SECONDS=21600
